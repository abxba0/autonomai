# API Keys for LLM Providers
# Configure one or more providers

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Deepseek (via OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Security Configuration
# REQUIRED: JWT secret key for token signing (generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))')
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# User credentials (for web API authentication)
# IMPORTANT: Change these in production!
ADMIN_PASSWORD=your_admin_password_here
ADMIN_EMAIL=admin@example.com
API_CLIENT_PASSWORD=your_api_client_password_here
API_CLIENT_EMAIL=api@example.com

# Database Configuration (for production)
DATABASE_URL=sqlite:///./self_optimizing.db

# Embeddings Configuration
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Caching & Performance
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# Distributed System Configuration
ENABLE_DISTRIBUTED_STATE=false
REDIS_STATE_URL=redis://localhost:6379/2
DISTRIBUTED_LOCK_TIMEOUT=30